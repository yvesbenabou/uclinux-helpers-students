# Keep the root filesystem out of xipImage and mount it directly from Flash.
# CONFIG_BLK_DEV_INITRD is not set
CONFIG_INITRAMFS_SOURCE=""

CONFIG_MTD=y
CONFIG_MTD_ROM=y
CONFIG_MTD_PHYSMAP=y
CONFIG_MTD_PHYSMAP_OF=y
CONFIG_MTD_OF_PARTS=y

CONFIG_MISC_FILESYSTEMS=y
CONFIG_ROMFS_FS=y
CONFIG_ROMFS_BACKED_BY_MTD=y
# CONFIG_ROMFS_BACKED_BY_BLOCK is not set
# CONFIG_ROMFS_BACKED_BY_BOTH is not set

# The board-specific helper initializes SPI5, the ILI9341 and LTDC, while
# simplefb only exposes the reserved RGB565 scanout buffer as /dev/fb0.
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_STM32=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_STM32F429_DISCO_SIMPLE=y
# CONFIG_DRM is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set

# Keep the teaching image's console on USART1.
# CONFIG_FRAMEBUFFER_CONSOLE is not set
